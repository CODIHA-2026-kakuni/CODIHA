# ------------------------------------------------------------
# MySQL 接続用 環境変数テンプレート
# ------------------------------------------------------------
# 使い方: このファイルをコピーして .env を作成し、必要に応じて値を書き換える
#   cp .env.example .env
# .env 自体は .gitignore 済みのため、コミットしないこと。
# ------------------------------------------------------------

DB_USER=codiha
DB_PASSWORD=codiha
DB_NAME=codiha

# Docker Compose のMySQLコンテナで使用するローカル開発用の初期値
MYSQL_ROOT_PASSWORD=rootpassword
