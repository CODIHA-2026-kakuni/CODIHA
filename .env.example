# ------------------------------------------------------------
# MySQL 接続用 環境変数テンプレート
# ------------------------------------------------------------
# 使い方: このファイルをコピーして .env を作成し、必要に応じて値を書き換える
#   cp .env.example .env
# .env には認証情報が含まれるため、Gitや提出ZIPには含めないこと。
# ------------------------------------------------------------

# Docker Compose利用時は compose.yaml 側で設定されるため、変更不要です。
# Dockerを使わずローカルで直接起動する場合のみ設定してください。
# DB_HOST=localhost
# DB_PORT=3306

DB_USER=codiha
DB_PASSWORD=codiha
DB_NAME=codiha

# Docker Compose のMySQLコンテナで使用するローカル開発用の初期値
MYSQL_ROOT_PASSWORD=rootpassword
