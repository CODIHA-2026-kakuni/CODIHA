# ------------------------------------------------------------
# MySQL 接続用 環境変数テンプレート
# ------------------------------------------------------------
# 使い方: このファイルをコピーして .env を作成し、必要に応じて値を書き換える
#   cp .env.example .env
# .env 自体は .gitignore 済みのため、コミットしないこと。
# ------------------------------------------------------------

DB_HOST=db
DB_PORT=3306
DB_USER=codiha
DB_PASSWORD=codiha
DB_NAME=codiha

# Docker Compose の mysql サービスで root パスワードを設定する場合に使用
MYSQL_ROOT_PASSWORD=rootpassword
